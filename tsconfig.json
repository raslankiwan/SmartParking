{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/admin/**/*.ts",
    "apps/admin/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "api/**/*.ts"
  ]
}
