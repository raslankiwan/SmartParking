{
  "name": "smartparking-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:contracts && concurrently -k 'npm run dev -w @smartparking/api' 'npm run dev -w @smartparking/admin'",
    "build": "npm run build:contracts && npm run typecheck && npm run build -w @smartparking/admin",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:contracts && tsx --test apps/api/test/*.test.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin:promote": "tsx --env-file=.env.local scripts/promote-admin.ts",
    "db:demo": "tsx --env-file=.env.local scripts/seed.ts --demo",
    "build:contracts": "npm run build -w @smartparking/contracts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.0.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
